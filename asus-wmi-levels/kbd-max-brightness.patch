+/*
+ * Highest keyboard backlight level. The WMI interface carries a 7-bit level
+ * (DEVS 0x00050021 takes 0x80 | level), but most firmware only has duty values
+ * for levels 0-3. Raise this only when the firmware's duty table has been
+ * extended to match, e.g. by asus_kbd_pwkb on the Zenbook S 14 (UX5406SA).
+ */
+static int kbd_max_brightness = ASUS_EV_MAX_BRIGHTNESS;
+module_param(kbd_max_brightness, int, 0444);
+MODULE_PARM_DESC(kbd_max_brightness,
+		 "Highest keyboard backlight level, 1-127 (default 3). Only raise it if the firmware has a duty value for every level.");
+
